DATABASE_URL=sqlite:///./tandem.db
# Postgres (postgresql:// est aussi accepté) : DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tandem
# puis appliquer le schéma : alembic upgrade head
# Pool de connexions Postgres (défauts : 5 et 10)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5176
# Plusieurs instances derrière un répartiteur de charge : diffusion et présence partagées via Redis.
# Absent (défaut) : tout en mémoire, une seule instance.
# REDIS_URL=redis://localhost:6379/0
# En production, le serveur refuse de démarrer sans vrai JWT_SECRET
# APP_ENV=production
