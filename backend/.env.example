DATABASE_URL=sqlite:///./tandem.db
# Postgres (postgresql:// est aussi accepté) : DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tandem
# puis appliquer le schéma : alembic upgrade head
# Pool de connexions Postgres (défauts : 5 et 10)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5176
# Plusieurs instances derrière un répartiteur de charge : diffusion et présence partagées via Redis.
# Absent (défaut) : tout en mémoire, une seule instance.
# REDIS_URL=redis://localhost:6379/0
# Adresses publiques de l'API (retour OAuth : {PUBLIC_API_URL}/api/auth/<google|github>/callback)
# et de l'application (redirection après connexion)
PUBLIC_API_URL=http://localhost:8040
FRONTEND_URL=http://localhost:5176
# « Continuer avec Google » / « Continuer avec GitHub » : bouton affiché seulement si l'identifiant
# ET le secret sont définis (voir le README pour créer les applications OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# En production, le serveur refuse de démarrer sans vrai JWT_SECRET
# APP_ENV=production
